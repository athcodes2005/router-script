# Copy to .env and set permissions to 0600 (chmod 600 .env)

# --- Required: IITB Captive Portal Credentials ---
USER=your_ldap_id
PASS=your_internet_access_token

# --- Optional: WARP Client Tuning ---
# Congestion control: cubic (binary default), bbr, bbr2, or reno
WARP_CC=bbr2
# Upload CoDel queue-delay target in ms (1-999, 0 = disabled)
# WARP_UPLOAD_CODEL=20
# TUN-read backpressure threshold in datagrams (0 = disabled)
# WARP_TUN_BACKPRESSURE=0

# --- Optional: Git Auto-Updater (update_from_git.sh) ---
# Private repository to pull scripts from (leave unset to disable script auto-pull)
# GITHUB_REPO=athcodes2005/router-script
# Fine-grained GitHub PAT with Contents:Read and Checks:Read on router-script
# GITHUB_TOKEN=github_pat_...
# Branch to track (only commits with all passing CI check-runs are promoted)
# DEPLOY_BRANCH=deploy

# --- Optional: usque-rs Binary Auto-Fetcher (fetch_usque_rs.sh) ---
# Public repository and release tag to fetch the ARM64 musl binary from
# USQUE_REPO=athcodes2005/usque-rs-openwrt
# USQUE_RELEASE_TAG=latest
# AUTO_FETCH_USQUE=1
