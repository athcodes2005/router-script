# Copy to .env and set permissions to 0600 (chmod 600 .env)

# --- Required: IITB Captive Portal Credentials ---
USER=your_ldap_id
PASS=your_internet_access_token

# --- Optional: WARP Client Tuning ---
# Congestion control: cubic (binary default), bbr, bbr2, or reno
WARP_CC=bbr2
# Upload CoDel queue-delay target in ms (1-999, default 20, 0 = disabled)
# WARP_UPLOAD_CODEL=20
# TUN-read backpressure threshold in datagrams (0 = disabled)
# WARP_TUN_BACKPRESSURE=0
# UDP receive buffer in bytes for the client's QUIC socket (0-67108864, 0 = kernel
# default). Unset uses the binary's built-in 4 MiB (usque-rs v0.2.2 and later).
# WARP_UDP_RECV_BUFFER=4194304

# --- Optional: Game mode ---
# Seconds after which a forgotten game mode turns itself off (0 = never)
# GAME_MODE_MAX_SECONDS=28800

# --- Optional: Git Auto-Updater (update_from_git.sh) ---
# Repository to pull scripts from (leave unset to disable script auto-pull).
# The updater is off until this is set in the router's .env.
# GITHUB_REPO=athcodes2005/router-script
# Fine-grained GitHub PAT with Contents:Read and Checks:Read on router-script.
# The repository is public, so the updater also runs without one, but GitHub
# allows anonymous API calls only 60 an hour per address, and the router shares
# its WARP or campus address with many others.
# GITHUB_TOKEN=github_pat_...
# Branch to track (only commits with all passing CI check-runs are promoted)
# DEPLOY_BRANCH=deploy

# --- Optional: usque-rs Binary Auto-Fetcher (fetch_usque_rs.sh) ---
# Public repository and release tag to fetch the ARM64 musl binary from. The
# default tag is pinned in defaults.sh together with the sha256 of its archive
# (bump both in a commit to roll out a new release); set USQUE_RELEASE_TAG=latest
# to follow every new release instead. A tag set here is not held to the pinned
# hash; USQUE_RELEASE_SHA256 gives it one of its own.
# USQUE_REPO=athcodes2005/usque-rs-openwrt
# USQUE_RELEASE_TAG=v0.2.3
# USQUE_RELEASE_SHA256=
# AUTO_FETCH_USQUE=1
