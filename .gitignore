# Secrets: never commit. Mode 0600 on disk; see wiki-llm/wiki/security/secrets-and-trust.md
.env
config.json
config.json.previous

# Runtime evidence pulled from the router (may expose topology and client destinations)
logs/*
!logs/.gitkeep
diagnostics/

# Build output, fetched binaries, and local noise
usque-rs
usque-rs-upstream-v0.1.0
.usque_release_sha
.deployed_commit
__pycache__/
*.pyc
.DS_Store
